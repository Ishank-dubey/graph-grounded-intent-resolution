{
  "manifest_version": 3,
  "name": "OmniStudio Tools",
  "version": "0.1.0",
  "description": "Export and import OmniStudio DataPacks, inspect runtime DataJSON, FlexCard events, and backend call traces.",
  "permissions": ["cookies", "tabs", "scripting", "sidePanel", "storage", "webRequest"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": { "service_worker": "dist/background-dev.js", "type": "module" },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OmniStudio Tools",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "dist/panel.html" },
  "content_scripts": [
    {
      "matches": ["https://*.salesforce.com/*", "https://*.force.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.salesforce.com/*", "https://*.force.com/*"],
      "js": ["dist/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
